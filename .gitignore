# --- Секреты и личные данные (НИКОГДА не коммитить) ---
# Данные моста на Windows живут в %LOCALAPPDATA%\ClaudeBridge (вне репозитория);
# правила ниже — страховка на случай ручного копирования файлов в клон.
bridge/config.json
bridge/certs/
bridge/pairings.json
bridge/internet.json
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
.env
owner.token
*.token
bridge.pass
bridge/sessions/

# --- Node ---
node_modules/
npm-debug.log*

# --- Android ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/release/
*.apk
*.aab

# --- Rust (туннель) ---
tunnel/target/

# --- Собранные нативные бинарники (собираются из исходников) ---
bridge/bin/
android/app/src/main/jniLibs/

# --- Инструменты/отчёты/агенты ---
.claude/
.claude-ide/
.serena/
# Система спеков для агентов — локальная, машинно-специфичная (как в bga-backend)
Specs/
AGENTS.md
CLAUDE.md
tools/check-specs.mjs
tools/inject-specs-entry.mjs
.opencode/
CLAUDE-SECURITY-*/
# Отчёты аудита с описанием ещё не закрытых уязвимостей — не публиковать
SECURITY_AUDIT_*.md

